[app]
title = Gimi AI
package.name = gimi
package.domain = org.gimi
source.dir = .
source.include_exts = py,png,jpg,kv,atlas
version = 0.1
requirements = python3,kivy==2.3.0,google-genai,requests,urllib3,certifi,idna,charset-normalizer,pydantic,typing-extensions
orientation = portrait
fullscreen = 0
android.permissions = INTERNET,RECORD_AUDIO
android.api = 33
android.minapi = 21
android.ndk = 25b
android.archs = arm64-v8a
